{
  "name": "gift-draw-onchain",
  "private": true,
  "version": "20.0.0",
  "type": "module",
  "description": "On-chain transparency mirror for GiftDraw.today — program source, settlement rules, verification scripts",
  "scripts": {
    "verify-program-binary": "tsx scripts/verify-program-binary.ts",
    "verify-entrants": "tsx scripts/verify-entrants.ts",
    "verify-settlement": "tsx scripts/verify-settlement.ts",
    "verify-seed": "tsx scripts/verify-seed.ts",
    "decode-kind-rolled": "tsx scripts/decode-kind-rolled.ts",
    "web:dev": "vite --config web/vite.config.ts",
    "web:build": "tsc -p web && vite build --config web/vite.config.ts",
    "web:preview": "vite preview --config web/vite.config.ts"
  },
  "dependencies": {
    "@noble/hashes": "^1.8.0",
    "@solana/web3.js": "^1.95.4",
    "bs58": "^6.0.0",
    "buffer": "^6.0.3"
  },
  "devDependencies": {
    "@types/node": "^22.16.5",
    "tsx": "^4.19.2",
    "typescript": "^5.8.3",
    "vite": "^6.4.3"
  }
}
